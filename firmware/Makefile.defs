#    In the nrf52 sdk, will auto detection current platform: posix or windows.
#    If your <arm-none-eabi> is already installed, and version and path is this:
#    Version     : 10.3.1
#    Windows-path: C:/Program Files (x86)/GNU Arm Embedded Toolchain/10 2021.10/bin
#    POSIX  -path: /usr/local/gcc-arm-none-eabi-10.3-2021.10/bin/
#    You can ignore this file modify.
# Warning: your toolchain path not allow PR to public repo!!!
# If you need define the toolchain path, plz delete annotate and change it.
#GNU_INSTALL_ROOT ?= /your/toolchain/path/
#GNU_VERSION ?= 8.8.8
#GNU_PREFIX ?= arm-none-eabi


PROJECT_NAME     := chameleon_ultra_firmware
OUTPUT_DIRECTORY := ../objects
PROJ_DIR         := ./src
SDK_ROOT         := ../nrf52_sdk
SRC_COMMON       := ../common
LD_DIR           := $(SRC_COMMON)

# Device type supported
CHAMELEON_ULTRA := ultra
CHAMELEON_LITE  := lite
# What device is it?

CURRENT_DEVICE_TYPE ?= ${CHAMELEON_ULTRA}

# Versioning information
# Semver MAJOR.MINOR[.PATCH] from the nearest git tag -- tag-only, never
# auto-bumps on its own, matching conventional semver.
# Falls back to APP_FW_VER_FALLBACK when git or a matching tag is unavailable
# (tarball / CI build), so those builds never hit the Makefile's version error.
APP_FW_VER_FALLBACK := 2.3.0
GIT_TAG          := $(shell git describe --tags --abbrev=0 --match "v[0-9]*" 2>/dev/null)
APP_FW_SEMVER    := $(patsubst v%,%,$(or $(GIT_TAG),v$(APP_FW_VER_FALLBACK)))
APP_FW_VER_MAJOR := $(word 1,$(subst ., ,$(APP_FW_SEMVER)))
APP_FW_VER_MINOR := $(word 2,$(subst ., ,$(APP_FW_SEMVER)))
APP_FW_VER_PATCH := $(or $(word 3,$(subst ., ,$(APP_FW_SEMVER))),0)
# Human-readable build string: semver + commits-since-tag + short commit
# hash, so it advances every commit, not just every tag push. Degrades to
# bare semver in a tarball/CI build (no git, or no tag reachable -- both
# GIT_COMMITS and GIT_REV come back empty, same as before).
GIT_REV       := $(shell git rev-parse --short=7 HEAD 2>/dev/null)
GIT_DIRTY     := $(shell git diff --quiet 2>/dev/null || echo -dirty)
GIT_COMMITS   := $(if $(GIT_TAG),$(shell git rev-list --count $(GIT_TAG)..HEAD 2>/dev/null))
GIT_VERSION   := v$(APP_FW_SEMVER)$(if $(GIT_COMMITS),-$(GIT_COMMITS))$(if $(GIT_REV),-g$(GIT_REV)$(GIT_DIRTY))

# Enable NRF_LOG on SWO pin as UART TX
NRF_LOG_UART_ON_SWO_ENABLED := 0

# Enable SDK validation checks
SDK_VALIDATION := 0
