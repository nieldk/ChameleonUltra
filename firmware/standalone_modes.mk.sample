# Persistent standalone-mode build config.
#
# Copy this file to standalone_modes.mk (gitignored, same directory --
# shared by Ultra and Lite builds) and uncomment/edit the lines you want.
# Every `./build.sh` / `make` picks it up automatically from then on -- no
# need to pass STANDALONE_*=1 on the command line each time. A one-off
# override still wins over this file for a single build:
#
#   STANDALONE_AUTHTRACE=1 ./build.sh
#
# Each mode's own default (if this file is absent, or a line here stays
# commented out) is set in firmware/application/Makefile. Currently: all
# off.
#
# See CONTRIBUTING STANDALONE.md for what each mode does and the full
# build-flag mechanics.

# STANDALONE_AUTHTRACE       ?= 1   # reader-side auth capture (Ultra only)
# STANDALONE_SLOT_CYCLE      ?= 1   # cycle emulation slots on a timer
# STANDALONE_AUTOCLONE       ?= 1   # auto-clone a presented card (writes!)
# STANDALONE_READ_REPLAY     ?= 1   # read now, replay later (writes!)
# STANDALONE_DICT_CHECK      ?= 1   # dictionary key check against a card (Ultra only)
# STANDALONE_EMUL_TRACE      ?= 1   # trace emulated-tag traffic
# STANDALONE_NFC_CANARY      ?= 1   # alert on an unexpected reader field
# STANDALONE_HF14A_TAP_SNIFF ?= 1   # passive HF14A tap sniff (Ultra only)
# STANDALONE_RELAY           ?= 1   # BLE peer relay (Ultra only)
# STANDALONE_GDB_GATEWAY     ?= 1   # CDC becomes a GDB memory/flash gateway (no SWD)
# STANDALONE_U2F             ?= 1   # FIDO U2F (CTAP1) over NFC — needs vendored micro-ecc in src/crypto/micro-ecc/
# STANDALONE_ZIGBEE          ?= 1   # passive 802.15.4 (Zigbee) receive via SoftDevice timeslots
# STANDALONE_SPECTRUM        ?= 1   # one-shot 2.4 GHz ISM energy-detect sweep via SoftDevice timeslots
# STANDALONE_USB_NET         ?= 1   # USB Ethernet + CLI over TCP; swaps USB to TinyUSB + lwIP (run ./fetch_usbnet_deps.sh first, ~10 KB RAM)

# gdb_gateway tuning (only matters when STANDALONE_GDB_GATEWAY=1):
# GDB_GATEWAY_EXEC           ?= 0       # 0 = memory/flash only (smaller); 1 = + breakpoints/step
# GDB_GATEWAY_PKT            ?= 0x800   # RSP PacketSize; raise for faster bulk reads, more RAM (default 0x200)

# usb_net tuning (only matters when STANDALONE_USB_NET=1):
# USBNET_CLASS               ?= ecm     # default host class (changeable at run time with `standalone config usb-net --class`)
# USBNET_MTU                 ?= 1514    # USB Ethernet frame size (default 1514; 600 saves ~1.8 KB RAM but Windows RNDIS needs 1514)
